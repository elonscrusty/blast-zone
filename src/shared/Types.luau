--!strict
-- Shared words every piece uses. Types only, no code. Pieces do not edit this file: ask the
-- coordinator if a type must change, so ten threads never disagree about a shape.

export type FighterId = string -- "p<UserId>" for a player, "b<number>" for a bot

export type Fighter = {
	id: FighterId,
	name: string,
	isBot: boolean,
	player: Player?, -- nil for bots
	model: Model, -- has a Humanoid and a PrimaryPart; Combat keeps its Attributes up to date
}

-- What a fighter wants this moment. Players send `aim` and `fire` over the `Intent` remote and
-- walk on their own client (the server only checks the speed). Bots fill in `move` too.
export type Intent = {
	move: Vector2?, -- bots only: x = right, y = forward, length 0..1
	aim: Vector2, -- unit length, on the floor plane
	fire: boolean,
}

export type Action = "heavy" | "dodge" | "heal"

export type Phase = "Lobby" | "Countdown" | "Playing" | "Results"

export type Currency = "cogs" | "gems" | "trophies"
export type WeaponId = "blaster" | "cannon" | "roll"
export type HeroId = "wobbles" | "spark" | "bruno"

export type Loadout = {
	heroId: HeroId,
	heroLevel: number, -- 1..10
	weaponLevels: { [WeaponId]: number }, -- 1..10
}

-- Perks picked during one match. perkId -> stacks (1..3). See plans/design/02-design.md.
export type Perks = { [string]: number }

-- Read-only copy of one fighter's live numbers (the same numbers sit in the model's Attributes:
-- Hp, MaxHp, Shield, Kits, Ammo, Alive).
export type FighterState = {
	hp: number,
	maxHp: number,
	shield: number,
	kits: number,
	ammo: number,
	alive: boolean,
}

-- Everything saved for one player. `version` lets old saves be upgraded (see ProfileSchema).
export type Profile = {
	version: number,
	cogs: number,
	gems: number,
	trophies: number,
	selectedHero: HeroId,
	heroes: { [HeroId]: { level: number, xp: number, unlocked: boolean } },
	weaponLevels: { [WeaponId]: number },
	heroCards: { [HeroId]: number }, -- progress toward unlocking a locked hero
	chests: number, -- unopened Toy Chests
	stats: { matches: number, wins: number, kills: number },
	daily: {
		day: number,
		points: number,
		tasks: { [string]: number },
		claimed: { [string]: boolean },
	},
	login: { day: number, streak: number },
	tutorialDone: boolean,
}

export type Placement = { fighter: Fighter, place: number, kills: number, surviveSeconds: number }

-- Server-only event names on `Bus` and what each carries. Fire and listen only to these.
export type BusEvents = {
	MatchPhase: Phase,
	FighterSpawned: Fighter,
	FighterDamaged: {
		victim: Fighter,
		source: Fighter?,
		amount: number,
		weapon: string,
		crit: boolean,
	},
	FighterEliminated: { victim: Fighter, killer: Fighter?, weapon: string },
	MatchEnded: { placements: { Placement } },
	BlastBoom: { cells: { Vector2 } },
	XpGained: { fighter: Fighter, amount: number },
	LevelUp: { fighter: Fighter, level: number },
}

return {}
