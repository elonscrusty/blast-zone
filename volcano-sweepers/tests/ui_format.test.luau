--!strict
local Harness = require("./harness")
local Format = require("../src/shared/Ui/Format")

Harness.test("Format.compact: small numbers stay plain", function()
	Harness.eq(Format.compact(0), "0")
	Harness.eq(Format.compact(7), "7")
	Harness.eq(Format.compact(999), "999")
	Harness.eq(Format.compact(999.9), "999")
end)

Harness.test("Format.compact: K M B T", function()
	Harness.eq(Format.compact(1000), "1K")
	Harness.eq(Format.compact(1234), "1.2K")
	Harness.eq(Format.compact(12345), "12.3K")
	Harness.eq(Format.compact(123456), "123K")
	Harness.eq(Format.compact(1500000), "1.5M")
	Harness.eq(Format.compact(3400000), "3.4M")
	Harness.eq(Format.compact(2e9), "2B")
	Harness.eq(Format.compact(7.3e12), "7.3T")
end)

Harness.test("Format.compact: rounding never shows 1000K", function()
	Harness.eq(Format.compact(999999), "1M")
	Harness.eq(Format.compact(999500), "1M")
	Harness.eq(Format.compact(999499), "999K")
	Harness.eq(Format.compact(9999), "10K")
end)

Harness.test("Format.compact: bad input is safe", function()
	Harness.eq(Format.compact(0 / 0), "0")
	Harness.eq(Format.compact(math.huge), "MAX")
	Harness.eq(Format.compact(-1500), "-1.5K")
	Harness.eq(Format.compact(-5), "-5")
	Harness.eq(Format.compact("x" :: any), "0")
end)

Harness.test("Format.commas", function()
	Harness.eq(Format.commas(0), "0")
	Harness.eq(Format.commas(999), "999")
	Harness.eq(Format.commas(1000), "1,000")
	Harness.eq(Format.commas(1234567), "1,234,567")
	Harness.eq(Format.commas(123456), "123,456")
	Harness.eq(Format.commas(-4321), "-4,321")
	Harness.eq(Format.commas(0 / 0), "0")
end)

Harness.test("Format.countdown rounds up and never shows 0:00 early", function()
	Harness.eq(Format.countdown(0), "0:00")
	Harness.eq(Format.countdown(-3), "0:00")
	Harness.eq(Format.countdown(0.2), "0:01")
	Harness.eq(Format.countdown(7), "0:07")
	Harness.eq(Format.countdown(6.01), "0:07")
	Harness.eq(Format.countdown(65), "1:05")
	Harness.eq(Format.countdown(180), "3:00")
	Harness.eq(Format.countdown(3725), "1:02:05")
	Harness.eq(Format.countdown(0 / 0), "0:00")
end)

Harness.test("Format.secondsLeft", function()
	Harness.eq(Format.secondsLeft(3.2), 4)
	Harness.eq(Format.secondsLeft(3), 3)
	Harness.eq(Format.secondsLeft(-1), 0)
end)

Harness.test("Format.percent", function()
	Harness.eq(Format.percent(0), "0%")
	Harness.eq(Format.percent(0.456), "45%")
	Harness.eq(Format.percent(0.999), "99%")
	Harness.eq(Format.percent(1), "100%")
	Harness.eq(Format.percent(7), "100%")
	Harness.eq(Format.percent(-1), "0%")
	Harness.eq(Format.percent(0 / 0), "0%")
	Harness.eq(Format.percent(0.29), "29%")
end)

Harness.test("Format.pair", function()
	Harness.eq(Format.pair(12, 30), "12/30")
	Harness.eq(Format.pair(1500, 12000), "1.5K/12K")
end)

Harness.test("Format.clip keeps characters whole and cuts on a word", function()
	Harness.eq(Format.clip("Backpack full!", 40), "Backpack full!")
	local cut = Format.clip("That gate is locked — open it at the gate first please", 24)
	Harness.truthy(utf8.len(cut) ~= nil, "valid UTF-8")
	Harness.truthy((utf8.len(cut) :: number) <= 24, cut)
	Harness.eq(string.sub(cut, -3), "…")
	Harness.eq(cut, "That gate is locked —…")
	local emoji = Format.clip("✨✨✨✨✨✨✨✨✨✨", 4)
	Harness.eq(emoji, "✨✨✨…")
	Harness.truthy(utf8.len(emoji) ~= nil, "no half emoji")
	Harness.eq(Format.clip("abcdefghij", 5), "abcd…")
	Harness.eq(Format.clip(nil :: any, 5), "")
end)

Harness.test("format: the save note is calm while the save is still loading", function()
	Harness.eq(Format.offlineBadge(nil, nil), nil)
	Harness.eq(Format.offlineBadge(false, true), nil, "retrying alone is not offline")
	local loading = Format.offlineBadge(true, true)
	Harness.truthy(loading ~= nil and string.find(loading.text, "Loading", 1, true) ~= nil)
	local guest = Format.offlineBadge(true, false)
	Harness.truthy(guest ~= nil and string.find(guest.text, "Guest", 1, true) ~= nil)
end)
