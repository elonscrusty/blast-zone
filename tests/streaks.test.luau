--!strict
local Harness = require("./harness")
local StreakRules = require("../src/shared/StreakRules")
local Config = require("../src/shared/Config")

local function book()
	return StreakRules.new(Config.Streaks)
end

Harness.test("streak: first kill earns nothing", function()
	local n, r = book():recordKill("p1", 0)
	Harness.eq(n, 1)
	Harness.eq(r, nil)
end)

Harness.test("streak: tiers pay once at their count", function()
	local b = book()
	b:recordKill("p1", 0)
	local n2, r2 = b:recordKill("p1", 5)
	Harness.eq(n2, 2)
	Harness.eq((r2 :: any).tier.heal, 15)
	local _, r3 = b:recordKill("p1", 8)
	Harness.eq((r3 :: any).tier.speedSeconds, 4)
	local _, r4 = b:recordKill("p1", 10)
	Harness.eq(r4, nil, "no tier at 4")
	local n5, r5 = b:recordKill("p1", 12)
	Harness.eq(n5, 5)
	Harness.truthy(r5 ~= nil)
end)

Harness.test("streak: too slow starts over", function()
	local b = book()
	b:recordKill("p1", 0)
	local n = b:recordKill("p1", Config.Streaks.windowSeconds + 1)
	Harness.eq(n, 1)
end)

Harness.test("streak: exactly at window edge continues", function()
	local b = book()
	b:recordKill("p1", 0)
	local n = b:recordKill("p1", Config.Streaks.windowSeconds)
	Harness.eq(n, 2)
end)

Harness.test("streak: fighters are separate and reset works", function()
	local b = book()
	b:recordKill("p1", 0)
	b:recordKill("b2", 1)
	b:recordKill("p1", 2)
	Harness.eq(b:get("p1"), 2)
	Harness.eq(b:get("b2"), 1)
	b:reset("p1")
	Harness.eq(b:get("p1"), 0)
	b:clear()
	Harness.eq(b:get("b2"), 0)
end)

Harness.test("streak: tier values stay sane", function()
	for _, t in Config.Streaks.tiers do
		Harness.truthy(t.heal >= 0 and t.heal <= 50, "heal small")
		Harness.truthy(t.speedMultiplier >= 1 and t.speedMultiplier <= 1.4, "speed under cap")
		Harness.truthy(t.speedSeconds <= 8, "boost brief")
	end
end)
